	}


		 functions
		 {
			 Deluge
			 {
				 float calculateStayCost(int nights, float price)
                 {
                 	return nights * price;
                 }
			 }
		 }


		workflow
		{
		form
		{
			auto_set_booking_reference as "Auto-Set Booking Reference"
			{
				type =  form
				form = guest_booking

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Generate unique booking reference using current date, time, and user ID
										if(isBlank(input.booking_reference))
										{
											// Get current date and time components
											currentDate = zoho.currentdate;
											currentTime = zoho.currenttime;
											// Extract year, month, day, hour, minute from current date/time
											year = currentDate.substring(0,4);
											month = currentDate.substring(5,7);
											day = currentDate.substring(8,10);
											hour = currentTime.substring(11,13);
											minute = currentTime.substring(14,16);
											// Get logged in user ID for uniqueness
											userId = zoho.loginuserid;
											// Generate unique booking reference: YYYYMMDDHHMM-USERID
											bookingRef = year.concat(month).concat(day).concat(hour).concat(minute).concat("-").concat(userId);
											// Set the booking reference value
											input.booking_reference = bookingRef;
										}
						)
					}
				}

			}
			validate_checkout_date as "Validate Check-out Date"
			{
				type =  form
				form = guest_booking

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Validate that check-out date is not before check-in date
										if(input.check_out_date != null && input.check_in_date != null)
										{
											if(input.check_out_date < input.check_in_date)
											{
												alert "Error: Check-out date cannot be before check-in date. Please correct the dates and try again.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			send_confirmation_email as "Send Confirmation Email"
			{
				type =  form
				form = guest_booking

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch guest email from input
										if(input.guest_email.isNull())
										{
											info "Guest email is missing";
										}
										else
										{
											// Prepare booking details for email
											bookingReference = input.booking_reference;
											guestName = input.guest_name.first_name.concat(" ").concat(input.guest_name.last_name);
											checkInDate = input.check_in_date.toString("dd-MMM-yyyy");
											checkOutDate = input.check_out_date.toString("dd-MMM-yyyy");
											roomNumber = input.room.room_number;
											totalAmount = input.total_amount.toString();
											// Construct email message
											emailSubject = "Booking Confirmation - " + bookingReference;
											emailMessage = "<p>Dear " + guestName + ",</p>";
											emailMessage = emailMessage.concat("<p>Your booking has been successfully confirmed.</p>");
											emailMessage = emailMessage.concat("<p><strong>Booking Reference:</strong> " + bookingReference + "</p>");
											emailMessage = emailMessage.concat("<p><strong>Room:</strong> " + roomNumber + "</p>");
											emailMessage = emailMessage.concat("<p><strong>Check-in Date:</strong> " + checkInDate + "</p>");
											emailMessage = emailMessage.concat("<p><strong>Check-out Date:</strong> " + checkOutDate + "</p>");
											emailMessage = emailMessage.concat("<p><strong>Total Amount:</strong> " + totalAmount + "</p>");
											emailMessage = emailMessage.concat("<p>Thank you for choosing our hotel!</p>");
											// Send confirmation email
											sendmail
											[
												from :zoho.loginuserid
												to :input.guest_email
												subject :emailSubject
												message :emailMessage
												content type :HTML
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			daily_maintenance_alert as "Daily Maintenance Alert"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch rooms under maintenance from room_inventory form
										roomsUnderMaintenance = room_inventory[maintenance_status == "UnderMaintenance"];
										// Check if there are any rooms under maintenance
										if(roomsUnderMaintenance.count() > 0)
										{
											// Build notification message
											notificationMessage = "The following rooms are currently under maintenance:\n\n";
											for each  room in roomsUnderMaintenance
											{
												roomNumber = room.room_number;
												floor = room.floor;
												notificationMessage = notificationMessage.concat(roomNumber).concat(" (Floor: ").concat(floor.toString()).concat(")\n");
											}
											// Send notification email to admin
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.adminuserid
												subject :"Daily Room Maintenance Notification"
												message :notificationMessage
											]
										}
					)
					}
				}
			}
		}


