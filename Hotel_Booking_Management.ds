 application "Hotel Booking Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form guest_booking
		{
			displayname = "Guest Booking"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			guest_name
			(
    			type = name
				displayname = "Guest Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			guest_email
			(
    			type = email
				displayname = "Guest Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			guest_phone
			(
    			type = phonenumber
				displayname = "Guest Phone"
	 			row = 1
	 			column = 1   
				width = medium
			)
			room
			(
				type = picklist	
				displayname = "Room"
				values  = room_inventory.ID
    			displayformat = [room_number]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			check_in_date
			(
    			type = date
				displayname = "Check In Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			check_out_date
			(
    			type = date
				displayname = "Check Out Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			booking_status
			(
				type = picklist
				displayname = "Booking Status"
				values = {"CheckedIn","Confirmed","Cancelled","CheckedOut"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			special_requests
			(
    			type = textarea
				displayname = "Special Requests"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			total_amount
			(
				displayname = "Total Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			booking_reference
			(
    			type = text
				displayname = "Booking Reference"
	 			row = 1
	 			column = 1   
				width = medium
			)
			guest_notes
			(
    			type = textarea
				displayname = "Guest Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Booking Draft","Booking Confirmed","Booking Cancelled","Pre-Arrival","Booking Modified","Guest Checked In","Guest In Stay","Early Check Out","Guest Checked Out","Booking Completed"}
			}
		}
		form room_inventory
		{
			displayname = "Room Inventory"
			success message = "Room Inventory Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			room_number
			(
    			type = text
				displayname = "Room Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			room_type
			(
				type = picklist
				displayname = "Room Type"
				values = {"Suite","Single","Double"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			price_per_night
			(
				displayname = "Price Per Night"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = radiobuttons
				displayname = "Status"
				values = {"Occupied","Available"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			floor
			(
				type = number
				displayname = "Floor"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			amenities
			(
				type = list	
				displayname = "Amenities"
				values = {"TV","Wi-Fi","Balcony","MiniBar","PoolAccess"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			max_occupancy
			(
				type = number
				displayname = "Max Occupancy"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			room_description
			(
    			type = textarea
				displayname = "Room Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			maintenance_status
			(
				type = picklist
				displayname = "Maintenance Status"
				values = {"UnderMaintenance","Operational","OutofService"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_cleaned
			(
    			type = date
				displayname = "Last Cleaned"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Room Created","Available for Booking","Under Maintenance","Out of Service","Booked","Checked In","Cancelled","Checked Out","Extended Stay","Pending Cleaning"}
			}
		}
	}
	reports
	{
		list guest_booking_Report
		{
			displayName = "Guest Booking Report"
			show all rows from guest_booking    
			(
				guest_name  as "Guest Name"
				guest_email as "Guest Email"
				guest_phone as "Guest Phone"
				room as "Room"
				check_in_date as "Check In Date"
				check_out_date as "Check Out Date"
				booking_status as "Booking Status"
				special_requests as "Special Requests"
				total_amount as "Total Amount"
				(
					display = total,average,min,max	
				)
				booking_reference as "Booking Reference"
				guest_notes as "Guest Notes"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (booking_status == "Cancelled")
				fields = [booking_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (booking_status == "CheckedIn")
				fields = [booking_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (booking_status == "CheckedOut")
				fields = [booking_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban guest_booking_by_booking_status
		{
			displayName = "Booking Statuses"
			show all rows from guest_booking    
			(
				guest_name  as "Guest Name"
				guest_email as "Guest Email"
				guest_phone as "Guest Phone"
				room as "Room"
				check_in_date as "Check In Date"
				check_out_date as "Check Out Date"
				booking_status as "Booking Status"
				special_requests as "Special Requests"
				total_amount as "Total Amount"
				(
					display = total,average,min,max	
				)
				booking_reference as "Booking Reference"
				guest_notes as "Guest Notes"
			)
			options
			(
	 			display field = booking_status
	 		)
		}
		list room_inventory_Report
		{
			displayName = "All Room Inventories"
			show all rows from room_inventory    
			(
				room_number as "Room Number"
				room_type as "Room Type"
				price_per_night as "Price Per Night"
				(
					display = total,average,min,max	
				)
				status as "Status"
				floor as "Floor"
				amenities as "Amenities"
				max_occupancy as "Max Occupancy"
				room_description as "Room Description"
				maintenance_status as "Maintenance Status"
				last_cleaned as "Last Cleaned"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (room_type == "Double")
				fields = [room_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (room_type == "Single")
				fields = [room_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (room_type == "Suite")
				fields = [room_type]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban room_inventory_by_room_type
		{
			displayName = "Room Types"
			show all rows from room_inventory    
			(
				room_number as "Room Number"
				room_type as "Room Type"
				price_per_night as "Price Per Night"
				(
					display = total,average,min,max	
				)
				status as "Status"
				floor as "Floor"
				amenities as "Amenities"
				max_occupancy as "Max Occupancy"
				room_description as "Room Description"
				maintenance_status as "Maintenance Status"
				last_cleaned as "Last Cleaned"
			)
			options
			(
	 			display field = room_type
	 		)
		}
	}
	pages
	{
		page DashBoard
		{
			displayname = "Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='25%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#F97164'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '20px'\n\tpaddingLeft = '20px'\n\tpaddingRight = '0px'\n\tpaddingBottom = '20px'\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\t\twidth = '64%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginTop = '8px'\n\tcolor = '#FFFFFF'\n\tsize = '24px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\n\tdisplayType = 'actual'\n\tdecimalPlaces = '2'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t  value = 'thisapp.guest_booking.total_amount.sum'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '8px' \n\tmarginTop = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '14px'\n\ttype = 'Text'\n\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\n\n\n\n\n\t  value = 'Total Total Amounts'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc><pc \n\t\tpadding = '20px'\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\t\twidth = '36%'\n\t\thAlign = 'right'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '10px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\n\tcolor = '#FFFFFF'\n\tbgColor = '#C75A50'\n\twidth = '40px'\n\theight = '40px'\n\ttype = 'icon'\n\tvalue = 'business-percentage-39'\n\tsize = '22px'\n\tcornerRadius = '10px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='24%'\n   \t>\n\t<panel element